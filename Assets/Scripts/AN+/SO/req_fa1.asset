  responseText: "# [\u0422\u0435\u043A\u0441\u0442 \u043F\u0435\u0441\u043D\u0438
    \xABReality\xBB]\r\n\r\n## [\u041A\u0443\u043F\u043B\u0435\u0442]\r\n\u0411\u043E\u0439
    \u0441\u0442\u0438\u0445, \u043D\u043E\r\n\u0415\u0449\u0451 \u043D\u0430\u043F\u043E\u0441\u043B\u0435\u0434\u043E\u043A
    \xABLet\u2019s go!\xBB \u043A\u0440\u0438\u043A\u043D\u0443\r\n\u0422\u0435\u0431\u0435
    \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u043E\u0447\u0435\u0441\u0442\u044C
    \u044D\u043F\u0438\u043B\u043E\u0433 \u0438 \u043F\u043E\u0441\u0442-\u0441\u043A\u0440\u0438\u043F\u0442\u0443\u043C\r\n\u0418
    \u0441\u043D\u043E\u0432\u0430 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044C
    \u043C\u043E\u0451\u2005\u043B\u0438\u0446\u043E\u2005\u0432 \u0433\u0438\u0444\u043A\u0443\r\n\u041A\u0430\u0440\u0442\u0438\u043D\u0430
    \u0441\u043D\u044F\u0442\u0430:\u2005\u0440\u0430\u043C\u043A\u0430, \u0445\u043E\u043B\u0441\u0442,
    \u0431\u0438\u0442\u0432\u0430\u2026 \u0441\u0442\u043E\u043F, \u0442\u0438\u0442\u0440\u044B\r\n-
    \u041F\u0435\u043F\u0435\u043B \u0438\u2005\u0432\u043E\u0434\u0430\r\n- \u041E\u0442\u043F\u0435\u043B\u0430
    \u043C\u0435\u0434\u043D\u0430\u044F \u0442\u0440\u0443\u0431\u0430\r\n- \u041F\u043E
    \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044F\u043C \u044D\u0442\u043E \u0431\u044B\u043B\u0430
    \u0441\u0442\u043E\u043B\u0435\u0442\u043D\u044F\u044F \u0432\u043E\u0439\u043D\u0430\r\n\u0412
    \u0447\u0435\u0441\u0442\u044C \u043F\u043E\u0431\u0435\u0434\u044B \u043D\u0430\u043B\u0438\u0432\u0430\u0435\u043C
    \u043E\u043F\u043F\u043E\u043D\u0435\u043D\u0442\u0430\u043C \u0432 \u043A\u0430\u0431\u0430\u043A\u0430\u0445\r\n\u041F\u0435\u0439
    \u0434\u043E \u0434\u043D\u0430, \u043F\u043E\u043A\u0443\u0434\u0430 \u043F\u044B\u043B\u044C
    \u043D\u0430 \u044D\u043F\u043E\u043B\u0435\u0442\u044B \u043D\u0435 \u043B\u0435\u0433\u043B\u0430\r\n\u042D\u0439\r\n\u0414\u043E\u0448\u043B\u0438
    \u043D\u0435 \u0432\u0441\u0435\r\n\u041E\u0434\u043D\u0438 \u0441\u0447\u0438\u0442\u0430\u044E\u0442,
    \u0447\u0442\u043E \u044F \u0441\u043E\u0437\u0434\u0430\u043B \u043C\u043E\u043D\u0441\u0442\u0440\u0430\r\n\u0425\u043E\u0442\u044C
    \u0438 \u043D\u0435 \u0441\u043B\u044B\u0448\u0435\u043D \u0441\u044D\u043C\u043F\u043B,
    \u044F \u0432\u0441\u0451 \u0435\u0449\u0451 \u041E\u043A\u0441\u0438 \u041E\u0441\u0431\u043E\u0440\u043D\r\n\u041D\u0435
    \u0431\u0443\u0434\u0443 \u0432\u0440\u0430\u0442\u044C: \u0434\u0430, \u043C\u043D\u0435
    \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0433\u0440\u0443\u0441\u0442\u043D\u043E\r\n\u041D\u043E
    \u0434\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0438\u0437 \u0448\u0435\u0441\u0442\u0435\u0440\u044B\u0445
    \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0430\u043A\u0440\u043E\u044E \u0441\u0442\u043E\u043B
    \u0441\u0432\u043E\u0439\r\n\u041D\u0435 \u0431\u044B\u043B\u043E \u043A\u0430\u0440\u0442\u044B,
    \u044F \u043F\u043E \u043F\u0430\u043C\u044F\u0442\u0438 \u0448\u0451\u043B \u0438
    \u0432\u0451\u043B\r\n\u0421\u0443\u0434\u044C\u0431\u0430 \u0432\u043D\u043E\u0441\u0438\u0442
    \u043F\u0440\u0430\u0432\u043A\u0438, \u0432\u0435\u0434\u044C \u044D\u0442\u043E
    \u0440\u0435\u0430\u043B\u0438\u0442\u0438-\u0448\u043E\u0443 \u0435\u0451\r\n\u042D\u0442\u043E
    \u043B\u0438\u0448\u044C \u043A\u043E\u0433\u0434\u0430 \u043F\u043E\u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0435,
    \u0447\u0442\u043E \u043C\u0438\u043D\u0451\u0442\r\n\u0422\u043E \u0431\u044B\u0442\u044C
    \u043C\u043E\u0436\u0435\u0442 \u0441 \u0442\u0435\u043F\u043B\u043E\u043C, \u043F\u043E\u0437\u0430\u0431\u044B\u0432
    \u043D\u044B\u0442\u044C\u0451\r\n\u042D-\u0439\u043E\r\n\u041F\u0435\u0440\u0435\u043C\u043E\u0442\u043A\u0430
    \u043D\u0430\u0437\u0430\u0434: \u043F\u043E\u0440\u043E\u0432\u043D\u0443 \u0444\u0438\u043B\u043A\u0438,
    \u0441\u043F\u043E\u0440\u044B \u0432 \u0441\u0435\u0442\u0438\r\n\u041F\u043E\u0442\u043E\u043C
    \u0433\u043E\u043B\u0443\u0431\u0438, \u0442\u0438\u0433\u0440\u044B, \u0441\u0442\u043E\u043B
    \u0441 \u043B\u0438\u043C\u0443\u0437\u0438\u043D\u043E\u043C, \u043E\u0442\u0431\u043E\u0440\u044B,
    \u0442\u0438\u0437\u0435\u0440\r\n\u041F\u043E\u043B\u0442\u043E\u0440\u0430
    \u0433\u043E\u0434\u0430 \u0442\u0440\u0438\u043F \u2014 \u044D\u0442\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0441\u0443\u0440\u043E\u0432\u044B\u0439 \u043B\u0438\u0437\u0435\u0440\r\n\u0418
    \u0436\u0438\u0437\u043D\u044C \u043F\u043E\u0434\u043C\u0438\u0433\u0438\u0432\u0430\u0435\u0442
    \u0441 \u0443\u043B\u044B\u0431\u043A\u043E\u044E \u041C\u043E\u043D\u044B \u041B\u0438\u0437\u044B,
    \u0441\u043B\u044B\u0448\u044C\r\n\u0411\u044B\u0442\u044C \u043C\u043E\u0436\u0435\u0442,
    \u044F \u043D\u0438\u043A\u0447\u0451\u043C\u043D\u044B\u0439 \u043C\u0435\u043D\u0442\u043E\u0440,
    \u043E\u0431\u0440\u0435\u0447\u0451\u043D \u043C\u043E\u0439 \u0432\u0435\u043A\u0442\u043E\u0440\r\n\u0421
    \u0442\u0435\u0445 \u043F\u043E\u0440, \u043A\u0430\u043A \u0432\u0435\u0440\u043D\u043E\u0439
    \u0441\u0447\u0451\u043B \u0434\u043B\u044F \u0421\u0435\u043A\u0442\u043E\u0440\u0430
    \u0447\u0451\u0440\u043D\u0443\u044E \u043C\u0435\u0442\u043A\u0443\r\n\u041D\u043E
    \u043C\u043D\u0435 \u0432\u0430\u0436\u043D\u0435\u0439 \u043F\u043E\u0431\u0435\u0434\u044B
    \u043C\u0438\u0440 \u0431\u044B\u043B, \u043A\u0430\u043A \u0432 \u041F\u0430\u043B\u0435\u0441\u0442\u0438\u043D\u0435\r\n\u041C\u044B
    \u0432\u0441\u0435 \u0447\u0435\u043C\u0443-\u0442\u043E \u043D\u0430\u0443\u0447\u0438\u043B\u0438\u0441\u044C
    \u043D\u0430 \u0412\u043E\u0439\u043D\u0435 \u0421\u0442\u0438\u043B\u0435\u0439\r\nYou
    might also like\r\n\u0411\u043E\u0433 \u0412 \u0414\u0435\u0442\u0430\u043B\u044F\u0445
    (God In Details)\r\nOxxxymiron\r\n\u041A\u0430\u043A \u041C\u043E\u0438 \u0414\u0435\u043B\u0430
    (How Am I Doing)\r\nOxxxymiron\r\nImperial\r\nOxxxymiron\r\n[\u041F\u0440\u0438\u043F\u0435\u0432]\r\n\u0420\u0430\u0437
    \u0447\u0430\u0441 \u043F\u043E\u0434\u0432\u043E\u0434\u0438\u0442\u044C \u0438\u0442\u043E\u0433\u0438
    \u0432\u0437\u044F\u043B \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E
    \u043F\u0440\u043E\u0431\u0438\u043B\r\n\u0417\u043D\u0430\u0439, \u0447\u0442\u043E
    \u0442\u044B \u043D\u0430 \u043F\u043E\u0440\u043E\u0433\u0435, \u0442\u043E
    \u0431\u0438\u0448\u044C \u0443 \u043D\u0430\u0447\u0430\u043B\u0430 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0438\u0441\u0442\u043E\u0440\u0438\u0439\r\n\u041E\u0439, \u0431\u043B\u044F,
    \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0431\u044B\u043B\u043E, \u043F\u043E\u043C\u043D\u0438\u0448\u044C,
    \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0445 \u0444\u0430\u043D\u0442\u0430\u0441\u043C\u0430\u0433\u043E\u0440\u0438\u0439?\r\n\u042F
    \u0433\u043B\u044F\u043D\u0443 \u0447\u0435\u0440\u0435\u0437 \u043F\u043B\u0435\u0447\u043E
    \u043B\u0438\u0448\u044C \u2014 \u0432\u043E\u0442 \u0438 \u0432\u0441\u0451,
