  id: note_1_analize
  title: Note Analize
  promptText: ",\u0424\u0424\u0412"
  responseText: "[\u0422\u0435\u043A\u0441\u0442 \u043F\u0435\u0441\u043D\u0438 \xAB\u042F
    \u0445\u0435\u0439\u0442\u0435\u0440\xBB]\r\n\r\n[\u0418\u043D\u0442\u0440\u043E]\r\n\u0415
    (\u0419\u043E\u0443)\r\n\u0412\u0430\u043B\u0435\u043D\u0442\u0438\u043D \u0414\u044F\u0434\u044C\u043A\u0430,
    \u043C\u044B \u0435\u0434\u0435\u043C \u0432 \u0414\u0438\u0431\u0443\u043D\u044B\r\n\r\n[\u041A\u0443\u043F\u043B\u0435\u0442]\r\n\u0420\u044D\u043F\u0435\u0440\u044B
    \u0433\u0440\u043E\u0437\u044F\u0442\u0441\u044F \u0431\u0438\u0444\u0430\u043C\u0438
    \u0438 \u0434\u0438\u0441\u0441\u0430\u043C\u0438\r\n\u0420\u0438\u0444\u043C\u0430\u043C\u0438
    \u0438 \u0441\u043A\u0438\u043B\u0437\u0430\u043C\u0438, \u043A\u043B\u0438\u043F\u0430\u043C\u0438,
    \u0440\u0435\u043B\u0438\u0437\u0430\u043C\u0438\r\n\u041E\u0431\u043B\u0438\u0437\u044B\u0432\u0430\u044F
    \u043C\u0430\u0440\u043A\u0438 \u043A\u0430\u043A \u0444\u0438\u043B\u0430\u0442\u0435\u043B\u0438\u0441\u0442\u044B\r\n\u0412\u044B
    \u043D\u0430\u0440\u043A\u0438! \u042F \u0432\u0430\u0441 \u0440\u0430\u0437\u043D\u0435\u0441\u0443,
    \u0430 \u0432\u044B \u2014 \u043B\u0438\u0448\u044C \u0421\u041F\u0418\u0414
    \u0438 \u0441\u0438\u0444\u0438\u043B\u0438\u0441\r\n\u042F \u2014 \u0441\u0442\u0430\u043A\u0430\u043D,
    \u0442\u044B \u2014 \u0441\u0442\u043E\u043F\u043A\u0430. \u041C\u044B \u043D\u0435
    \u043E\u0434\u043D\u0430 \u0442\u0443\u0441\u043E\u0432\u043A\u0430\r\n\u0422\u0432\u043E\u0439
    \u0440\u044D\u043F \u2014 \u043F\u043E\u0434\u0442\u0430\u0441\u043E\u0432\u043A\u0430,
    \u043C\u043E\u0439 \u0440\u044D\u043F \u2014 \u043F\u043E\u0442\u0430\u0441\u043E\u0432\u043A\u0430\r\n\u0422\u0432\u043E\u044F
    \u043A\u0440\u044E \u043D\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0442\u0441\u044F,
    \u043D\u0435 \u043F\u044C\u0451\u0442 \u0438 \u043D\u0435 \u043A\u0443\u0440\u0438\u0442\r\n\u041D\u043E
    \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043A\u0430\u043A \u0412\u0438\u0446\u0438\u043D,
    \u041C\u043E\u0440\u0433\u0443\u043D\u043E\u0432 \u0438 \u041D\u0438\u043A\u0443\u043B\u0438\u043D\r\n\u042F
    \u043F\u0443\u043B\u0435\u043D\u0435\u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u043C\u044B\u0439,
    \u0432 \u0431\u0443\u0440\u0435 \u043D\u0435\u043F\u043E\u0442\u043E\u043C\u043B\u044F\u0435\u043C\u044B\u0439\r\n\u0414\u0443\u0440\u0435\u043D\u044C,
    \u0442\u0435\u0431\u044F \u043F\u0438\u043D\u0430\u043B\u0438 \u043C\u044B! \u0425\u0443\u043B\u0438
    \u0432\u044B \u0437\u0430\u043B\u0443\u043F\u0430\u043B\u0438\u0441\u044C, \u0431\u043B\u0438\u043D?\r\n\u0414\u0430\u0436\u0435
    Coolio \u043D\u0435 \u0442\u0430\u043A \u0443\u043B\u044C\u0442\u0440\u0430\u043F\u0440\u0438\u043C\u0438\u0442\u0438\u0432\u0435\u043D\r\n\u041C\u044B
    \u0432\u0430\u043C \u0440\u0443\u043A\u0438 \u043F\u0440\u0435\u0432\u0435\u043D\u0442\u0438\u0432\u043D\u043E
    \u043A \u0434\u0438\u0434\u0436\u0435\u0439-\u043F\u0443\u043B\u044C\u0442\u0443
    \u043F\u0440\u0438\u0432\u0438\u043D\u0442\u0438\u043B\u0438\r\n\u0422\u044B
    \u0447\u0438\u0442\u0430\u0435\u0448\u044C \u043F\u0440\u043E \u0431\u043E\u0433\u043E\u0432,
    \u043F\u0440\u043E \u0441\u0430\u0433\u0438 \u0438 \u043B\u0435\u0433\u0435\u043D\u0434\u044B\r\n\u041F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u044C
    \u0432\u044B\u043F\u0435\u043D\u0434\u0440\u0438\u0432\u0430\u0442\u044C\u0441\u044F,
    \u0441\u044B\u043D, \u0442\u044B \u0441\u043E\u0441\u0430\u043B \u043D\u0430
    \u0443\u0438\u043A\u0435\u043D\u0434\u0430\u0445\r\n\u0418 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
    \u043D\u0438\u043A\u0435\u043C. \u0422\u0432\u043E\u0439 \u043B\u0435\u0439\u0431\u043B
    \u043D\u0435 \u043C\u0430\u0442\u0451\u0440\u044B\u0439, cut tha shit\r\n\u042F
    \u0437\u0430\u0432\u0438\u0441\u0430\u044E \u0441 \u043C\u0430\u0440\u043E\u0434\u0451\u0440\u0430\u043C\u0438
    \u043D\u0430 \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435\r\n\u041F\u0435\u0448\u043A\u043E\u043C
    \u043F\u043E \u041B\u043E\u043D\u0434\u043E\u043D\u0443 \u0441 \u043C\u0435\u0448\u043A\u043E\u043C
    \u043F\u043E\u043B\u043E\u043D\u0438\u044F\r\n\u0420\u0443\u0441\u0441\u043A\u0438\u0439
    \u0440\u044D\u043F \u0431\u0435\u0437 \u044D\u043C\u0438\u0433\u0440\u0430\u0446\u0438\u0438
    \u2014 \u043D\u0438\u0447\u0442\u043E, \u043A\u043E\u043B\u043E\u043D\u0438\u044F\r\n\u0422\u044B
    \u0441\u0447\u0438\u0442\u0430\u043B, \u0447\u0442\u043E \xAB\u041A\u043E\u0434
    \u0434\u0430 \u0412\u0438\u043D\u0447\u0438\xBB \u0431\u044B\u043B \u043A\u043E\u0442\u043E\u043C
    \u044D\u0442\u043E\u0433\u043E \u0433\u0435\u043D\u0438\u044F \u0418\u0442\u0430\u043B\u0438\u0438\r\n\u0422\u0432\u043E\u0439
    \u0430\u0439-\u043A\u044C\u044E \u2014 \u043A\u0430\u043A \u0442\u0432\u043E\u0438
    \u0433\u0435\u043D\u0438\u0442\u0430\u043B\u0438\u0438 (\u0421\u043B\u044B\u0448\u044C!)\r\nYou
    might also like\r\n\u0413\u041B\u0410\u041C\u0423\u0420 (GLAMOUR)\r\nuniqe, nkeeei
    & ARTEM SHILOVETS\r\n\u041B\u043E\u043D\u0434\u043E\u043D \u043F\u0440\u043E\u0442\u0438\u0432
    \u0432\u0441\u0435\u0445 (London vs Everyone)\r\n\u0412\u0430\u043B\u0435\u043D\u0442\u0438\u043D
    \u0414\u044F\u0434\u044C\u043A\u0430 (Valentin Dyad'ka)\r\n13/08/17: Oxxxymiron
    vs. \u0421\u043B\u0430\u0432\u0430 \u041A\u041F\u0421\u0421\r\nVersus Battle\r\n[\u041F\u0440\u0438\u043F\u0435\u0432]\r\n\u042F
    \u0445\u0435\u0439\u0442\u0435\u0440: \u044F \u043D\u0435\u043D\u0430\u0432\u0438\u0436\u0443
    \u0432\u0430\u0448 \u0440\u044D\u043F, \u0432\u0430\u0448 \u0442\u0440\u0435\u043A,
    \u0432\u0430\u0448 \u0442\u0435\u043A\u0441\u0442\r\n\u041C\u044F\u0433\u043A\u0438\u0439,
    \u043A\u0430\u043A \u043F\u0430\u0448\u0442\u0435\u0442\r\n\u0425\u043E\u0443\u043C\u0438,
    \u044D\u0442\u043E \u043D\u0430\u0448 \u0432\u0435\u043A! \u041A\u0430\u0436\u0434\u044B\u0439
    \u043B\u043E\u0448\u043F\u0435\u0434\r\n\u041E\u0441\u043E\u0437\u043D\u0430\u0435\u0442,
    \u0447\u0442\u043E \u0443 \u043D\u0435\u0433\u043E \u043F\u0440\u043E\u0434\u0430\u0436
    \u043D\u0435\u0442\r\n\u042F \u0445\u0435\u0439\u0442\u0435\u0440: \u044F \u043D\u0435\u043D\u0430\u0432\u0438\u0436\u0443
    \u0432\u0430\u0448 \u0444\u043B\u043E\u0443, \u0432\u0430\u0448 \u0441\u043B\u043E\u0433,
    \u0432\u0430\u0448 \u0445\u043E\u043F\r\n\u041D\u0435 \u0432\u0430\u0436\u043D\u043E
    \u0437\u0430 \u0447\u0442\u043E!\r\n\u0425\u043E\u0443\u043C\u0438, \u044D\u0442\u043E
    \u043D\u0430\u0448 \u0433\u043E\u0434! \u0414\u043E \u0442\u0435\u0431\u044F
    \u0434\u043E\u0448\u043B\u043E?\r\n\u041E\u043A\u0441\u0438\u043C\u0438\u0440\u043E\u043D
    \u0438 \xAB\u041E\u043F\u0442\u0438\u043A \u0420\u0430\u0448\u0430\xBB \u2014
    \u0432 \u0432\u0430\u0448 \u0440\u043E\u0442!\r\n\r\n[\u0410\u0443\u0442\u0440\u043E]\r\n(\u0411\u0440-\u0440-\u0440\u0430!
    \u0415-\u0430!)\r\n\u042F \u0445\u0435\u0439\u0442\u0435\u0440, \u0451\u0431
    \u0442\u044B\r\n(\u0419\u043E\u0443-\u0439\u043E\u0443-\u0439\u043E\u0443-\u0439\u043E\u0443-\u0439\u043E\u0443-\u0439\u043E\u0443!)\r\n\u041E\u043A\u0441\u0438\u043C\u0438\u0440\u043E\u0448\u043A\u0438\u043D,
    \u043C\u043E\u0439 \u043C\u0438\u043B\u044B\u0439 \u0437\u0430\u0439\u0447\u0438\u043A\r\n(London!
    London! \u0421\u0443\u043A\u0430, \u0431\u043B\u044F\u0434\u044C)\r\n\u042F \u0442\u043E\u0436\u0435
